---
import { profile } from '../content/profile';
import Base from '../layouts/Base.astro';
// Written by Tanmay. Render it as-is: style it here, never edit its wording.
import { Content, getHeadings } from '../../content/field-report.md';

const headings = getHeadings();
// Nest deeper headings under the file's top heading level.
const topDepth = Math.min(...headings.map((heading) => heading.depth));
const indent = ['', 'pl-4', 'pl-8', 'pl-12'];
---

<Base title="Field report">
  <header class="sticky top-0 z-10 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
    <nav aria-label="Site" class="mx-auto flex h-14 max-w-3xl items-center px-5">
      <a href="/" class="text-sm text-zinc-300 hover:text-zinc-50">
        <span aria-hidden="true">←</span> Back to home
      </a>
    </nav>
  </header>
  <main class="mx-auto max-w-3xl px-5 pb-24">
    <div class="pt-16 sm:pt-24">
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">Field report</h1>
      <p class="mt-3 text-lg text-zinc-400">{profile.name}</p>
    </div>
    {
      headings.length > 0 && (
        <nav aria-labelledby="toc-title" class="mt-10 rounded-lg border border-zinc-800 bg-zinc-900 p-5 sm:p-6">
          <h2 id="toc-title" class="font-mono text-xs tracking-wider text-zinc-400 uppercase">
            Contents
          </h2>
          <ol class="mt-4 space-y-2">
            {headings.map((heading) => (
              <li class={indent[Math.min(heading.depth - topDepth, indent.length - 1)]}>
                <a href={`#${heading.slug}`} class="text-zinc-300 hover:text-zinc-50">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="markdown">
      <Content />
    </article>
  </main>
</Base>
