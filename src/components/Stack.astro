---
import { profile } from '../content/profile';
import Badges from './Badges.astro';
import Section from './Section.astro';
---

<Section id="stack" title="Stack">
  <div class="grid gap-6">
    {
      profile.stack.map((row) => (
        <div class="grid gap-3 sm:grid-cols-[12rem_1fr] sm:gap-6">
          <h3 class="text-sm font-medium text-stone-50">{row.label}</h3>
          <Badges items={row.items} label={row.label} />
        </div>
      ))
    }
  </div>
</Section>
