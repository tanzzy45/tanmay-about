---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul aria-label={label} class="flex flex-wrap gap-1.5">
  {
    items.map((item) => (
      <li class="rounded border border-stone-700 px-2 py-0.5 font-mono text-xs text-stone-200">{item}</li>
    ))
  }
</ul>
