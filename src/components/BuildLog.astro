---
import { profile } from '../content/profile';
import { formatDuration } from '../lib/format';
import { loadBuildLog, type CiResult } from '../lib/github';
import Section from './Section.astro';

// Runs once at build time and never throws: a failed GitHub call gives `ok: false`.
// Keep the section id, AiAgents links to #build-log.
const log = await loadBuildLog();

const linkClass = 'text-stone-50 underline decoration-stone-600 underline-offset-4 hover:decoration-accent';

const ci: Record<CiResult, { label: string; class: string }> = {
  passed: { label: 'CI passed', class: 'border-stone-500 text-stone-100' },
  failed: { label: 'CI failed', class: 'border-red-400/40 text-red-300' },
  pending: { label: 'CI pending', class: 'border-stone-600 text-stone-300' },
  none: { label: 'No CI', class: 'border-dashed border-stone-600 text-stone-400' },
};

const stats = log.ok
  ? [
      { label: 'PRs merged', value: String(log.stats.merged) },
      { label: 'Agents working at once', value: String(log.stats.agentsWorkingAtOnce) },
      {
        label: 'Agent time',
        value: log.stats.agentTimeMs === null ? '–' : formatDuration(log.stats.agentTimeMs),
      },
    ]
  : [];

// Without a repo there's no PR list to point at, so fall back to the GitHub profile.
const fallbackLink = log.pullsUrl
  ? { label: 'See the pull requests on GitHub', href: log.pullsUrl }
  : { label: 'See my GitHub profile', href: profile.contact.find((channel) => channel.label === 'GitHub')?.href };

const count = (n: number) => n.toLocaleString('en-US');
---

<Section id="build-log" title="How this page was built">
  {
    log.ok ? (
      <>
        <p class="max-w-prose leading-relaxed">
          Every merged pull request in{' '}
          <a href={`https://github.com/${log.repo}`} class={linkClass} rel="noopener noreferrer">this repo</a>,
          read from the GitHub API when the site was built.
        </p>

        <dl class="mt-6 grid grid-cols-3 gap-3">
          {stats.map((stat) => (
            <div class="flex flex-col justify-between gap-2 rounded-lg border border-stone-800 bg-stone-900 p-3 sm:p-4">
              <dt class="text-xs text-stone-400 sm:text-sm">{stat.label}</dt>
              <dd class="font-mono text-xl font-medium text-stone-50 sm:text-2xl">{stat.value}</dd>
            </div>
          ))}
        </dl>

        {log.prs.length > 0 ? (
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {log.prs.map((pr) => (
              <li class="flex flex-col rounded-lg border border-stone-800 bg-stone-900 p-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-xs text-stone-400">PR #{pr.number}</span>
                  <span class:list={['rounded border px-2 py-0.5 font-mono text-xs', ci[pr.ci].class]}>
                    {ci[pr.ci].label}
                  </span>
                </div>
                <h3 class="mt-3 font-semibold leading-snug">
                  <a href={pr.url} class={linkClass} rel="noopener noreferrer">
                    {pr.title}
                  </a>
                </h3>
                <p class="mt-2 break-all font-mono text-xs text-stone-400">
                  <span class="sr-only">Branch: </span>
                  {pr.branch}
                </p>
                <dl class="mt-auto grid grid-cols-3 gap-3 pt-5">
                  <div>
                    <dt class="text-xs text-stone-400">Files</dt>
                    <dd class="mt-0.5 font-mono text-sm text-stone-200">{count(pr.filesChanged)}</dd>
                  </div>
                  <div>
                    <dt class="text-xs text-stone-400">Lines</dt>
                    <dd class="mt-0.5 font-mono text-sm text-stone-200">
                      +{count(pr.additions)} −{count(pr.deletions)}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-xs text-stone-400">Open to merge</dt>
                    <dd class="mt-0.5 font-mono text-sm text-stone-200">
                      {formatDuration(Date.parse(pr.mergedAt) - Date.parse(pr.openedAt))}
                    </dd>
                  </div>
                </dl>
              </li>
            ))}
          </ol>
        ) : (
          <p class="mt-6">No merged pull requests yet.</p>
        )}
      </>
    ) : (
      <p class="max-w-prose leading-relaxed">
        The pull requests couldn't be loaded from GitHub when this page was built.{' '}
        {fallbackLink?.href && (
          <a href={fallbackLink.href} class={linkClass} rel="noopener noreferrer">
            {fallbackLink.label}
          </a>
        )}
      </p>
    )
  }
</Section>
