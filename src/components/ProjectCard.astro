---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Project } from '../content/profile';
import Badges from './Badges.astro';
import MaybeLink from './MaybeLink.astro';
import Todo from './Todo.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { image } = project;
// Checked at build time, so adding the file to public/ is enough to show it.
const imageExists = image ? existsSync(join(process.cwd(), 'public', image.src)) : false;
---

<article class="rounded-lg border border-zinc-800 bg-zinc-900 p-5 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold text-zinc-50">{project.name}</h3>
    {project.note && <p class="font-mono text-xs text-zinc-400">{project.note}</p>}
  </div>
  <p class="mt-1 text-sm text-zinc-400">{project.role ?? <Todo what="role" />}</p>
  {
    image &&
      (imageExists ? (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class="mt-5 h-auto w-full rounded border border-zinc-800 bg-zinc-950"
        />
      ) : (
        <div class="mt-5 flex aspect-video items-center justify-center rounded border border-dashed border-zinc-700 p-4">
          <Todo what={`add public${image.src}`} />
        </div>
      ))
  }
  <p class="mt-4 leading-relaxed">{project.description}</p>
  <div class="mt-5">
    <Badges items={project.stack} label={`${project.name} stack`} />
  </div>
  <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {
      project.links.map((link) => (
        <li>
          <MaybeLink link={link} />
        </li>
      ))
    }
  </ul>
</article>
