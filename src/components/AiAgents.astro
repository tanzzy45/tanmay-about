---
import { profile } from '../content/profile';
import MaybeLink from './MaybeLink.astro';
import Section from './Section.astro';
import Todo from './Todo.astro';
---

<Section id="ai-agents" title="How I work with AI agents">
  <ul class="list-disc space-y-3 pl-5 marker:text-zinc-600">
    {profile.aiAgents.bullets.map((bullet) => <li>{bullet ?? <Todo />}</li>)}
  </ul>
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    {
      profile.aiAgents.links.map((link) => (
        <li>
          <MaybeLink link={link} />
        </li>
      ))
    }
  </ul>
</Section>
