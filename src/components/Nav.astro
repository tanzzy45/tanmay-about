---
import { profile } from '../content/profile';

const links = [
  { href: '#shipped', label: 'Shipped' },
  { href: '#stack', label: 'Stack' },
  { href: '#ai-agents', label: 'AI agents' },
  { href: '#build-log', label: 'Build log' },
  { href: '#contact', label: 'Contact' },
];

// No underline until hover, then one in the accent, like the page's other text links.
const hover = 'decoration-accent underline-offset-4 hover:underline';
---

<header class="sticky top-0 z-10 border-b border-stone-800 bg-stone-950">
  <nav aria-label="Sections" class="mx-auto flex h-14 max-w-3xl items-center gap-6 px-5">
    <a href="#hero" class={`hidden shrink-0 font-serif text-xl text-stone-50 sm:block ${hover}`}>{profile.name}</a>
    <ul class="flex min-w-0 gap-3 overflow-x-auto py-1 text-sm sm:ml-auto sm:gap-5">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a href={link.href} class={`text-stone-300 hover:text-stone-50 ${hover}`}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
