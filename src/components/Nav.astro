---
import { profile } from '../content/profile';

const links = [
  { href: '#shipped', label: 'Shipped' },
  { href: '#stack', label: 'Stack' },
  { href: '#ai-agents', label: 'AI agents' },
  { href: '#build-log', label: 'Build log' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-10 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
  <nav aria-label="Sections" class="mx-auto flex h-14 max-w-3xl items-center gap-6 px-5">
    <a href="#hero" class="hidden shrink-0 font-semibold text-zinc-50 sm:block">{profile.name}</a>
    <ul class="flex min-w-0 gap-3 overflow-x-auto text-sm sm:ml-auto sm:gap-5">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a href={link.href} class="text-zinc-300 hover:text-zinc-50">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
