---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-zinc-800 py-14 sm:py-16">
  <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-tight text-zinc-50">{title}</h2>
  {Astro.slots.has('default') && <div class="mt-8"><slot /></div>}
</section>
