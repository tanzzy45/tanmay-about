---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-stone-800 py-14 sm:py-16">
  <h2 id={`${id}-title`} class="text-3xl text-stone-50 sm:text-4xl">{title}</h2>
  {Astro.slots.has('default') && <div class="mt-8"><slot /></div>}
</section>
