---
import { profile } from '../content/profile';
import MaybeLink from './MaybeLink.astro';

const button = 'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium';
---

<section id="hero" aria-labelledby="hero-title" class="pt-16 pb-14 sm:pt-24 sm:pb-16">
  <h1 id="hero-title" class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">
    {profile.name}
  </h1>
  <p class="mt-3 text-lg text-zinc-400">{profile.title}</p>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-300 sm:text-xl">{profile.headline}</p>
  <p class="mt-4 text-sm text-zinc-400">{profile.details.join(' · ')}</p>
  <ul class="mt-8 flex flex-wrap gap-3">
    {
      profile.contact.map((channel, i) => (
        <li>
          <MaybeLink
            link={channel}
            class={
              i === 0
                ? `${button} bg-emerald-400 text-zinc-950 hover:bg-emerald-300`
                : `${button} border border-zinc-700 text-zinc-50 hover:border-zinc-500`
            }
            todoClass={`${button} border border-dashed border-zinc-700 text-zinc-400`}
          />
        </li>
      ))
    }
  </ul>
</section>
