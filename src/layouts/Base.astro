---
// Self-hosted fonts, latin subset only (the page is in English). Vite bundles the files
// into dist/_astro, so no font request leaves the site.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
// The hero's font (the name), preloaded. Same file the CSS above points at.
import heroFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

interface Props {
  /** Page name, shown before the site name in the tab title. Omit on the home page. */
  title?: string;
}

const title = Astro.props.title
  ? `${Astro.props.title} · ${profile.name}`
  : `${profile.name} · ${profile.title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.headline} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
