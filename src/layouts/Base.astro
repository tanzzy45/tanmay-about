---
import '../styles/global.css';
import { profile } from '../content/profile';

interface Props {
  /** Page name, shown before the site name in the tab title. Omit on the home page. */
  title?: string;
}

const title = Astro.props.title
  ? `${Astro.props.title} · ${profile.name}`
  : `${profile.name} · ${profile.title}`;
// No favicon yet: the empty data URL stops the browser requesting /favicon.ico (a 404).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.headline} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <slot />
  </body>
</html>
